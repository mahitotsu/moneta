{
  "name": "infra",
  "version": "0.1.0",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "posttest": "bash scripts/sweep-rust-lambda-docker-cache.sh",
    "cdk": "NODE_OPTIONS=\"--require ./force-ipv4.cjs\" cdk",
    "synth": "npm run cdk -- synth",
    "diff": "npm run cdk -- diff",
    "deploy": "npm run cdk -- deploy",
    "postdeploy": "bash scripts/sweep-rust-lambda-docker-cache.sh",
    "destroy": "npm run cdk -- destroy",
    "clean-data": "NODE_OPTIONS=\"--require ./force-ipv4.cjs\" tsx scripts/clean-data.ts",
    "seed-demo-data": "NODE_OPTIONS=\"--require ./force-ipv4.cjs\" tsx scripts/seed-demo-data.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1101.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1101.0",
    "@aws-sdk/client-dynamodb": "^3.1101.0",
    "@aws-sdk/client-sqs": "^3.1101.0",
    "@aws-sdk/lib-dynamodb": "^3.1101.0",
    "@swc/core": "^1.15.0",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30",
    "@types/node": "^24.10.1",
    "aws-cdk": "2.1132.0",
    "jest": "^30",
    "tsx": "^4.23.0",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.261.0",
    "constructs": "^10.5.0"
  }
}
