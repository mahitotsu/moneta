# このファイルをコピーして .env.local を作成する(.env.local自体はgitignore対象)。
# 値は以下のコマンドで取得する:
#   aws cloudformation describe-stacks --stack-name MonetaAccountPipelineStack \
#     --query "Stacks[0].Outputs"
# stackが再作成されるとURLが変わりうるため、都度取得し直すこと(docs/adr/0006参照)。

VITE_QUERY_API_URL=https://xxxxxxxxxx.execute-api.ap-northeast-1.amazonaws.com/prod
VITE_COMMAND_API_URL=https://yyyyyyyyyy.execute-api.ap-northeast-1.amazonaws.com/prod
VITE_TRANSFER_QUERY_API_URL=https://zzzzzzzzzz.execute-api.ap-northeast-1.amazonaws.com/prod
VITE_TRANSFER_COMMAND_API_URL=https://wwwwwwwwww.execute-api.ap-northeast-1.amazonaws.com/prod
VITE_ACCOUNT_NUMBER_QUERY_API_URL=https://vvvvvvvvvv.execute-api.ap-northeast-1.amazonaws.com/prod

# 上記4つと違い、これは開発サーバーのプロキシ設定(vite.config.ts)ではなく
# src/auth.tsからimport.meta.env経由で直接読まれる——つまり`npm run dev`だけでなく
# `npm run build`(本番ビルド)時にも必要(docs/adr/0016)。CognitoのUserPoolClientId
# (SignUp/InitiateAuthの呼び出しにClientIdだけが必要で、UserPoolId自体はクライアント
# コードのどこからも参照しない)。
VITE_COGNITO_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
