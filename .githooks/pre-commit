#!/usr/bin/env bash
# コミット時にbuild/test/lintを強制する(壊れた状態をコミット履歴に残さないため)。
# セットアップ(cloneごとに1回): git config core.hooksPath .githooks
#
# infra/(CDK synth、Rust LambdaのDockerビルドを含み初回は数分かかる)とapi-e2e/(実AWS
# 環境が必要)はここには含めない。前者はGitHub Actionsで、後者は元々手動/実デプロイ環境限定
# (api-e2e/README.md参照)。
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "==> cargo build --workspace"
cargo build --workspace

echo "==> cargo test --workspace"
cargo test --workspace

echo "==> cargo clippy --workspace --all-targets"
cargo clippy --workspace --all-targets -- -D warnings

echo "==> web-ui: build (tsc -b && vite build)"
(cd web-ui && npm run build)

echo "==> web-ui: oxlint"
(cd web-ui && npx oxlint)

echo "==> web-ui: vitest"
(cd web-ui && npm run test)

echo "==> cargo sweep: remove build artifacts untouched for 14+ days"
# /targetは`cargo build --workspace`のたびに肥大化し続ける(15GB超に達したことがある)。
# `cargo clean`による全消しは次回ビルドを丸ごとやり直しにしてしまうため、直近14日
# ノータッチの成果物だけをルールベースで削除するcargo-sweep(要`cargo install cargo-sweep`)
# を使う。毎コミットで走らせても実際に削除が発生するのは古い成果物がある時だけで、
# 直近作業中のクレートの再ビルド速度には影響しない。
if command -v cargo-sweep >/dev/null 2>&1; then
  cargo sweep --time 14
else
  echo "  (cargo-sweep未インストールのためスキップ: cargo install cargo-sweep)"
fi

echo "==> pre-commit checks passed"
